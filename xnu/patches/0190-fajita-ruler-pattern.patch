+        /* Ruler pattern test: boot-arg sweetfb_pattern=1 */
+        int pattern = 0;
+        PE_parse_boot_argn("sweetfb_pattern", &pattern, sizeof(pattern));
+        if (pattern && fPixels) {
+                uint32_t w = fWidth;
+                uint32_t h = fHeight;
