+                                else if (y < 3 * h / 5) { l2 = 0xFF; }
+                                else if (y < 4 * h / 5) { l3 = 0xFF; }
+                                else { l0 = l1 = l2 = l3 = 0xFF; }
+                                if (x == 100 || x == 400 || x == 800 || x == 1200) {
+                                        l0 = l1 = l2 = l3 = 0xFF;
+                                }
+                                p[0] = l0; p[1] = l1; p[2] = l2; p[3] = l3;
+                        }
+                }
+                IOLog("SWEET FB: pattern test written\n");
+                return true;
+        }
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
