--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -214,6 +214,78 @@
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+        /* Value fill test: boot-arg sweetfb_pattern=1 sweetfb_fill=0xRRGGBBAA */
+        int pattern = 0;
+        PE_parse_boot_argn("sweetfb_pattern", &pattern, sizeof(pattern));
+        if (pattern && fPixels) {
+                uint32_t fill = 0;
+                PE_parse_boot_argn("sweetfb_fill", &fill, sizeof(fill));
+                sweet_console_muted = 1;  /* suppress kernel console drawing */
+                fDirty = false;           /* stop vsyncFired from copying over the fill */
+                uint8_t *region = (uint8_t *)fPixels;
+                size_t regionSize = 0x2400000;
+                for (size_t i = 0; i < regionSize; i += 4) {
+                        region[i]     = (uint8_t)(fill & 0xFF);
+                        region[i + 1] = (uint8_t)((fill >> 8) & 0xFF);
+                        region[i + 2] = (uint8_t)((fill >> 16) & 0xFF);
+                        region[i + 3] = (uint8_t)((fill >> 24) & 0xFF);
+                }
+                IOLog("SWEET FB: value fill 0x%08x written\n", fill);
+                /* Readback: verify the fill reached the mapping */
+                uint32_t rb0 = *(volatile uint32_t *)region;
+                uint32_t rb1 = *(volatile uint32_t *)(region + 4);
+                uint32_t rbMid = *(volatile uint32_t *)(region + (regionSize / 2));
+                int noreg = 0;
+                PE_parse_boot_argn("sweetfb_noregdump", &noreg, sizeof(noreg));
+                if (!noreg) {
+                /* Register readout: map MDP and read SSPP state */
+                IOLog("SWEET FB: ladder 1: GCC display branches\n");
+                IOMemoryDescriptor *gccDesc = IOMemoryDescriptor::withPhysicalAddress(
+                    (IOPhysicalAddress)0x100000, 0x10000, kIODirectionNone);
+                IOMemoryMap *gccMap = gccDesc ? gccDesc->map(kIOMapInhibitCache) : NULL;
+                volatile uint32_t *gcc = gccMap ? (volatile uint32_t *)gccMap->getVirtualAddress() : NULL;
+                if (gcc) {
+                        for (uint32_t off = 0xb000; off < 0xc000; off += 0x1000) {
+                                IOLog("SWEET FB: GCC+0x%x = 0x%08x (CLK_OFF=%u)\n",
+                                    off, gcc[off/4], (gcc[off/4] >> 31) & 1);
+                        }
+                } else {
+                        IOLog("SWEET FB: GCC map failed\n");
+                }
+                if (gccMap) gccMap->release();
+                if (gccDesc) gccDesc->release();
+
+                IOLog("SWEET FB: ladder 2: DISPCC GDSC\n");
+                IOMemoryDescriptor *dispDesc = IOMemoryDescriptor::withPhysicalAddress(
+                    (IOPhysicalAddress)0xaf00000, 0x10000, kIODirectionNone);
+                IOMemoryMap *dispMap = dispDesc ? dispDesc->map(kIOMapInhibitCache) : NULL;
+                volatile uint32_t *disp = dispMap ? (volatile uint32_t *)dispMap->getVirtualAddress() : NULL;
+                if (disp) {
+                        IOLog("SWEET FB: DISPCC+0x3000 = 0x%08x (PWR_ON=%u)\n",
+                            disp[0x3000/4], (disp[0x3000/4] >> 31) & 1);
+                } else {
+                        IOLog("SWEET FB: DISPCC map failed\n");
+                }
+                if (dispMap) dispMap->release();
+                if (dispDesc) dispDesc->release();
+
+                IOLog("SWEET FB: ladder 3: MDSS version\n");
+                IOMemoryDescriptor *mdssDesc = IOMemoryDescriptor::withPhysicalAddress(
+                    (IOPhysicalAddress)0xae00000, 0x1000, kIODirectionNone);
+                IOMemoryMap *mdssMap = mdssDesc ? mdssDesc->map(kIOMapInhibitCache) : NULL;
+                volatile uint32_t *mdss = mdssMap ? (volatile uint32_t *)mdssMap->getVirtualAddress() : NULL;
+                if (mdss) {
+                        IOLog("SWEET FB: MDSS version = 0x%08x\n", mdss[0]);
+                } else {
+                        IOLog("SWEET FB: MDSS map failed\n");
+                }
+                if (mdssMap) mdssMap->release();
+                if (mdssDesc) mdssDesc->release();
+                }  /* end if (!noreg) */
+                IOLog("SWEET FB: fill readback first=0x%08x second=0x%08x mid=0x%08x (expected 0x%08x)\n",
+                    rb0, rb1, rbMid, fill);
+                return true;
+        }
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
 	uint32_t accelOn = 1;
