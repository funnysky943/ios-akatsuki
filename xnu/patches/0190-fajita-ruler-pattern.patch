--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -214,6 +214,29 @@
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+        /* Uniform fill test: boot-arg sweetfb_pattern=1 sweetfb_lane=N */
+        int pattern = 0;
+        PE_parse_boot_argn("sweetfb_pattern", &pattern, sizeof(pattern));
+        if (pattern && fPixels) {
+                uint32_t lane = 4;  /* 4 = all lanes 0xFF */
+                PE_parse_boot_argn("sweetfb_lane", &lane, sizeof(lane));
+                uint8_t *region = (uint8_t *)fPixels;
+                size_t regionSize = 0x2400000;  /* whole splash region */
+                uint8_t val[4] = {0, 0, 0, 0};
+                if (lane < 4) {
+                        val[lane] = 0xFF;
+                } else {
+                        val[0] = val[1] = val[2] = val[3] = 0xFF;
+                }
+                for (size_t i = 0; i < regionSize; i += 4) {
+                        region[i]     = val[0];
+                        region[i + 1] = val[1];
+                        region[i + 2] = val[2];
+                        region[i + 3] = val[3];
+                }
+                IOLog("SWEET FB: uniform fill lane %u written\n", lane);
+                return true;
+        }
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
 	uint32_t accelOn = 1;
