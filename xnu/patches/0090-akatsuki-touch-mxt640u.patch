+/* -------------------------------------------------------------- akatsuki */
+
+/*
+ * Clock enable for QUPv3 wrapper 0 SE5.
+ *
+ * 0x5200c is the GCC hlos1 vote register; bits 6/7 are M_AHB / S_AHB and
+ * bits 15/16 vote the per-SE branches. The wrapper 0 SE5 branch lives at
+ * 0x17094 per mainline gcc-sdm845.c (SE0 at 0x1701c, stride 0x18);
+ * Bergamota's BT UART patch instead names 0x17738 for SE5 (0x17750 for
+ * SE6), so both are read back and logged. Whichever clears bit 31 is the
+ * live one.
+ */
+static bool
+xz3_clocks(void)
+{
+	touch_wr(st.gcc, XZ3_GCC_VOTE, touch_rd(st.gcc, XZ3_GCC_VOTE) | XZ3_VOTE_BITS);
+	printf("SWEET TS: xz3 vote=%#x cbcr main=%#x alt=%#x\n",
+	    touch_rd(st.gcc, XZ3_GCC_VOTE),
+	    touch_rd(st.gcc, XZ3_SE5_CBCR),
+	    touch_rd(st.gcc, XZ3_SE5_CBCR_ALT));
+
+	uint32_t cfg = touch_rd(st.gcc, XZ3_SE5_CFG);
+	cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;   /* SRC=bi_tcxo, DIV=1 */
+	touch_wr(st.gcc, XZ3_SE5_CFG, cfg);
+	touch_wr(st.gcc, XZ3_SE5_CMD, touch_rd(st.gcc, XZ3_SE5_CMD) | 0x3u);  /* ROOT_EN|UPDATE */
+	if (!touch_wait_clear(st.gcc, XZ3_SE5_CMD, 1u)) {
+		printf("SWEET TS: RCG update timeout (cmd=%#x cfg=%#x)\n",
+		    touch_rd(st.gcc, XZ3_SE5_CMD), touch_rd(st.gcc, XZ3_SE5_CFG));
+		return false;
+	}
+
+	bool ok = false;
+	for (unsigned i = 0; i < 200; ++i) {
+		uint32_t v = touch_rd(st.gcc, XZ3_SE5_CBCR);
+		if (!(v & (1u << 31))) {
+			printf("SWEET TS: SE5 clock running (cbcr=%#x)\n", v);
+			ok = true;
+			break;
+		}
+		touch_wait(1);
+	}
+	if (!ok) {
+		uint32_t v = touch_rd(st.gcc, XZ3_SE5_CBCR);
+		uint32_t a = touch_rd(st.gcc, XZ3_SE5_CBCR_ALT);
+		printf("SWEET TS: SE5 clock still halted cbcr=%#x alt=%#x\n", v, a);
+		if (!(a & (1u << 31))) {
+			printf("SWEET TS: alt cbcr live, mainline offset may be wrong\n");
+		}
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Atmel maXTouch info block: 7 bytes at address 0x0000 on the 16-bit
+ * register space. Reads use the same touch_msg() primitive as fajita; the
+ * address is transmitted as a two-byte little-endian prefix, which is what
+ * the mXT family expects on I2C.
+ */
+static int
+mxt_read(uint16_t reg, uint8_t *buf, unsigned len)
+{
+	uint8_t addr[2] = { (uint8_t)(reg & 0xffu), (uint8_t)(reg >> 8) };
+	return touch_msg(XZ3_TS_ADDR, addr, 2, buf, len, true);
+}
+
+static bool
+mxt_probe(void)
+{
+	uint8_t ib[7] = {0};
+	int err = mxt_read(0x0000, ib, sizeof(ib));
+	if (err != 0) {
+		printf("SWEET MXT: info block read failed err=%d irq=%#x\n",
+		    err, st.irq_status);
+		return false;
+	}
+	printf("SWEET MXT: info family=%#x variant=%#x version=%#x build=%#x"
+	    " matrix=%ux%u objects=%u\n",
+	    ib[0], ib[1], ib[2], ib[3], ib[4], ib[5], ib[6]);
+	if (ib[0] == 0 && ib[6] == 0) {
+		printf("SWEET MXT: info block reads as all-zero, chip not answering\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_xz3_thread(__unused void *arg, __unused wait_result_t result)
+{
+	unsigned delay_s = 20;
+
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TS: akatsuki mXT640U, starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+
+	st.gcc = ml_io_map(XZ3_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(XZ3_TLMM_BASE, XZ3_TLMM_SIZE);
+	st.gpio_s = st.gpio;              /* single tile */
+	st.se = ml_io_map(XZ3_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("SWEET TS: MMIO mapping failed\n");
+		goto out;
+	}
+
+	/* VDD (AVDD) on PM8998 LDO28 at 3.008 V; VDDIO via gpio133. */
+	printf("SWEET TS: RPMh skipped, assuming AVDD is on\n");
+
+	/* VDDIO (133) high, ATTN (125) as pull-up input, RESET (99) high, then
+	 * low pulse, then release. Delays per the panel node: 0/1/1 ms. */
+	touch_gpio_at(st.gpio, XZ3_GPIO_VIO, 0, 0, 1, true, true);
+	touch_gpio_at(st.gpio, XZ3_GPIO_ATTN, 0, 3, 3, false, false);
+	touch_gpio_at(st.gpio, XZ3_GPIO_RESET, 0, 3, 2, true, true);
+	touch_wait(1);
+	touch_gpio_at(st.gpio, XZ3_GPIO_RESET, 0, 3, 2, true, false);
+	touch_wait(1);
+	touch_gpio_at(st.gpio, XZ3_GPIO_RESET, 0, 3, 2, true, true);
+	touch_wait(200);   /* chip boot */
+
+	if (!xz3_clocks()) {
+		goto out;
+	}
+	printf("SWEET TS: calling touch_se_init\n");
+	if (!touch_se_init()) {
+		printf("SWEET TS: touch_se_init failed\n");
+		goto out;
+	}
+	printf("SWEET TS: touch_se_init OK\n");
+
+	/* --- first milestone: info block only ------------------------------- */
+	printf("SWEET TS: calling mxt_probe\n");
+	st.probing = true;
+	bool ok = mxt_probe();
+	st.probing = false;
+	printf("SWEET TS: mxt_probe returned %d\n", ok ? 1 : 0);
+	if (!ok) {
+		goto out;
+	}
+	printf("SWEET MXT: probe OK, Patch B will parse the object table\n");
+
+	/* Keep the thread alive so we can re-probe from the log after boot. */
+	for (unsigned i = 0; i < 120 && !st.dead; ++i) {
+		touch_wait(1000);
+		(void)mxt_probe();
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
