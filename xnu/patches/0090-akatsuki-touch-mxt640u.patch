+/*
+ * Clock enable for QUPv3 wrapper 0 SE5.
+ *
+ * 0x5200c is the GCC hlos1 vote register; bits 6/7 are M_AHB / S_AHB and
+ * bits 15/16 vote the per-SE branches. The wrapper 0 SE5 branch lives at
+ * 0x17094 per mainline gcc-sdm845.c (SE0 at 0x1701c, stride 0x18);
+ * Bergamota's BT UART patch instead names 0x17738 for SE5 (0x17750 for
+ * SE6), so both are read back and logged. Whichever clears bit 31 is the
+ * live one.
+ */
+static bool
+xz3_clocks(void)
+{
+	touch_wr(st.gcc, XZ3_GCC_VOTE, touch_rd(st.gcc, XZ3_GCC_VOTE) | XZ3_VOTE_BITS);
+	printf("SWEET TS: xz3 vote=%#x cbcr main=%#x alt=%#x\n",
+	    touch_rd(st.gcc, XZ3_GCC_VOTE),
+	    touch_rd(st.gcc, XZ3_SE5_CBCR),
+	    touch_rd(st.gcc, XZ3_SE5_CBCR_ALT));
+
+	uint32_t cfg = touch_rd(st.gcc, XZ3_SE5_CFG);
+	cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;   /* SRC=bi_tcxo, DIV=1 */
+	touch_wr(st.gcc, XZ3_SE5_CFG, cfg);
+	touch_wr(st.gcc, XZ3_SE5_CMD, touch_rd(st.gcc, XZ3_SE5_CMD) | 0x3u);  /* ROOT_EN|UPDATE */
+	if (!touch_wait_clear(st.gcc, XZ3_SE5_CMD, 1u)) {
+		printf("SWEET TS: RCG update timeout (cmd=%#x cfg=%#x)\n",
+		    touch_rd(st.gcc, XZ3_SE5_CMD), touch_rd(st.gcc, XZ3_SE5_CFG));
+		return false;
+	}
+
+	bool ok = false;
+	for (unsigned i = 0; i < 200; ++i) {
+		uint32_t v = touch_rd(st.gcc, XZ3_SE5_CBCR);
+		if (!(v & (1u << 31))) {
+			printf("SWEET TS: SE5 clock running (cbcr=%#x)\n", v);
+			ok = true;
+			break;
+		}
+		touch_wait(1);
+	}
+	if (!ok) {
+		uint32_t v = touch_rd(st.gcc, XZ3_SE5_CBCR);
+		uint32_t a = touch_rd(st.gcc, XZ3_SE5_CBCR_ALT);
+		printf("SWEET TS: SE5 clock still halted cbcr=%#x alt=%#x\n", v, a);
+		if (!(a & (1u << 31))) {
+			printf("SWEET TS: alt cbcr live, mainline offset may be wrong\n");
+		}
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Atmel maXTouch info block: 7 bytes at address 0x0000 on the 16-bit
+ * register space. Reads use the same touch_msg() primitive as fajita; the
+ * address is transmitted as a two-byte little-endian prefix, which is what
+ * the mXT family expects on I2C.
+ */
+static int
+mxt_read(uint16_t reg, uint8_t *buf, unsigned len)
+{
+	uint8_t addr[2] = { (uint8_t)(reg & 0xffu), (uint8_t)(reg >> 8) };
+	/* touch_msg does not support combined send+receive in one call;
+	 * mirror touch_read: send address with stretch, then read data. */
+	int err = touch_msg(XZ3_TS_ADDR, addr, 2, NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	return touch_msg(XZ3_TS_ADDR, NULL, 0, buf, len, false);
+}
+
+/* Chunked read: register space is random-access, so re-issue the address
+ * per chunk. Chunk 32 bytes (8 FIFO words at 4 B/word) to stay well
+ * below touch_msg's 90-byte single-transfer limit. */
+static int
+mxt_read_chunked(uint16_t reg, uint8_t *buf, unsigned len)
+{
+	unsigned done = 0;
+	while (done < len) {
+		unsigned n = len - done;
+		if (n > 32) {
+			n = 32;
+		}
+		int err = mxt_read((uint16_t)(reg + done), buf + done, n);
+		if (err) {
+			return err;
+		}
+		done += n;
+	}
+	return 0;
+}
+
+/* CRC24 over the info block and object table, per atmel_mxt_ts.c
+ * mxt_calc_crc24. Feed bytes in (lo, hi) pairs; pad odd with 0. */
+static void
+mxt_crc24_step(uint32_t *c, uint8_t a, uint8_t b)
+{
+	uint32_t r = (*c << 1) ^ ((uint32_t)b << 8) ^ (uint32_t)a;
+	if (r & 0x1000000u) {
+		r ^= 0x80001Bu;
+	}
+	*c = r;
+}
+
+static uint32_t
+mxt_crc24(const uint8_t *buf, unsigned len)
+{
+	uint32_t c = 0;
+	unsigned i = 0;
+	for (; i + 1 < len; i += 2) {
+		mxt_crc24_step(&c, buf[i], buf[i + 1]);
+	}
+	if (i < len) {
+		mxt_crc24_step(&c, buf[i], 0);
+	}
+	return c & 0xFFFFFFu;
+}
+
+/* Object table (40 entries for mXT640U; 64 max for headroom). */
+#define MXT_MAX_OBJECTS 64u
+struct mxt_object {
+	uint8_t  type;
+	uint16_t addr;
+	uint8_t  size;
+	uint8_t  instances;
+	uint8_t  num_ids;
+	uint8_t  min_id;
+	uint8_t  max_id;
+};
+static struct mxt_object mxt_objs[MXT_MAX_OBJECTS];
+static uint8_t  mxt_nobjs;
+static uint8_t  mxt_t5_addr, mxt_t5_size;
+static uint8_t  mxt_t6_addr, mxt_t6_size;
+static uint8_t  mxt_t7_addr;
+static uint8_t  mxt_t44_addr;
+static uint8_t  mxt_t100_addr, mxt_t100_size;
+static uint8_t  mxt_t100_minid;
+static uint8_t  mxt_next_report_id;
++
+static bool
+mxt_probe(void)
+{
+	uint8_t ib[7] = {0};
+	int err = mxt_read(0x0000, ib, sizeof(ib));
+	if (err != 0) {
+		printf("SWEET MXT: info block read failed err=%d irq=%#x\n",
+		    err, st.irq_status);
+		return false;
+	}
+	printf("SWEET MXT: raw info %02x %02x %02x %02x %02x %02x %02x\n",
+	    ib[0], ib[1], ib[2], ib[3], ib[4], ib[5], ib[6]);
+	printf("SWEET MXT: info family=%#x variant=%#x version=%#x build=%#x"
+	    " matrix=%ux%u objects=%u\n",
+	    ib[0], ib[1], ib[2], ib[3], ib[4], ib[5], ib[6]);
+	if (ib[0] == 0 && ib[6] == 0) {
+		printf("SWEET MXT: info block reads as all-zero, chip not answering\n");
+		return false;
+	}
+
+	/* --- Object table + CRC ---------------------------------------- */
+	unsigned nobj = ib[6];
+	if (nobj == 0 || nobj > MXT_MAX_OBJECTS) {
+		printf("SWEET MXT: bad object count %u\n", nobj);
+		return false;
+	}
+	unsigned tbl_len = 7u + 6u * nobj;
+	unsigned total = tbl_len + 3u;
+	uint8_t buf[MXT_MAX_OBJECTS * 6u + 7u + 3u];
+	err = mxt_read_chunked(0x0000, buf, total);
+	if (err != 0) {
+		printf("SWEET MXT: table read failed err=%d len=%u\n", err, total);
+		return false;
+	}
+	uint32_t crc_calc = mxt_crc24(buf, tbl_len);
+	uint32_t crc_read = (uint32_t)buf[tbl_len]
+	    | ((uint32_t)buf[tbl_len + 1] << 8)
+	    | ((uint32_t)buf[tbl_len + 2] << 16);
+	printf("SWEET MXT: crc calc=%#x read=%#x %s\n",
+	    crc_calc, crc_read, crc_calc == crc_read ? "OK" : "MISMATCH");
+
+	/* --- Parse object table ---------------------------------------- */
+	mxt_nobjs = 0;
+	mxt_next_report_id = 1;
+	mxt_t5_addr = mxt_t6_addr = mxt_t7_addr = mxt_t44_addr = mxt_t100_addr = 0;
+	mxt_t5_size = mxt_t6_size = mxt_t100_size = 0;
+	mxt_t100_minid = 0;
+	const uint8_t *p = buf + 7;
+	for (unsigned i = 0; i < nobj; ++i, p += 6) {
+		struct mxt_object *o = &mxt_objs[mxt_nobjs++];
+		o->type      = p[0];
+		o->addr      = (uint16_t)(p[1] | ((uint16_t)p[2] << 8));
+		o->size      = (uint8_t)(p[3] + 1);
+		o->instances = (uint8_t)(p[4] + 1);
+		o->num_ids   = p[5];
+		if (o->num_ids) {
+			o->min_id = mxt_next_report_id;
+			mxt_next_report_id = (uint8_t)(mxt_next_report_id
+			    + o->num_ids * o->instances);
+			o->max_id = (uint8_t)(mxt_next_report_id - 1);
+		}
+		switch (o->type) {
+		case 5:   mxt_t5_addr   = o->addr; mxt_t5_size   = o->size; break;
+		case 6:   mxt_t6_addr   = o->addr; mxt_t6_size   = o->size; break;
+		case 7:   mxt_t7_addr   = o->addr; break;
+		case 44:  mxt_t44_addr  = o->addr; break;
+		case 100:
+			mxt_t100_addr = o->addr;
+			mxt_t100_size = o->size;
+			mxt_t100_minid = o->min_id;
+			break;
+		}
+	}
+	/* Compact table log: 5 objects per line */
+	for (unsigned i = 0; i < mxt_nobjs; i += 5) {
+		printf("SWEET MXT: obj[%u] ", i);
+		for (unsigned j = i; j < i + 5 && j < mxt_nobjs; ++j) {
+			struct mxt_object *o = &mxt_objs[j];
+			printf("T%u@%#x s%u i%u r%u  ",
+			    o->type, o->addr, o->size, o->instances, o->num_ids);
+		}
+		printf("\n");
+	}
+	printf("SWEET MXT: found T5=%u@%#x T6=%u@%#x T7@%#x T44@%#x"
+	    " T100=%u@%#x minid=%u nextid=%u\n",
+	    mxt_t5_size, mxt_t5_addr, mxt_t6_size, mxt_t6_addr,
+	    mxt_t7_addr, mxt_t44_addr,
+	    mxt_t100_size, mxt_t100_addr, mxt_t100_minid, mxt_next_report_id);
+	if (!mxt_t5_addr || !mxt_t100_addr) {
+		printf("SWEET MXT: missing T5 or T100, cannot proceed\n");
+		return false;
+	}
+
+	/* --- T100 config (offset+len checked against T100.size) -------- */
+	uint8_t t100cfg[32] = {0};
+	unsigned tlen = mxt_t100_size < sizeof(t100cfg) ? mxt_t100_size : sizeof(t100cfg);
+	err = mxt_read_chunked(mxt_t100_addr, t100cfg, tlen);
+	if (err == 0 && mxt_t100_size >= 26) {
+		uint8_t ctrl   = t100cfg[0];
+		uint8_t cfg1   = t100cfg[1];
+		uint8_t tchaux = t100cfg[3];
+		uint16_t xr    = (uint16_t)(t100cfg[13] | ((uint16_t)t100cfg[14] << 8));
+		uint16_t yr    = (uint16_t)(t100cfg[24] | ((uint16_t)t100cfg[25] << 8));
+		printf("SWEET MXT: T100 ctrl=%#x cfg1=%#x tchaux=%#x xrange=%u yrange=%u\n",
+		    ctrl, cfg1, tchaux, xr, yr);
+	} else {
+		printf("SWEET MXT: T100 config read failed err=%d size=%u\n",
+		    err, mxt_t100_size);
+	}
+
+	/* --- T6 status byte ------------------------------------------- */
+	if (mxt_t6_addr && mxt_t6_size >= 1) {
+		uint8_t st6 = 0;
+		if (mxt_read(mxt_t6_addr, &st6, 1) == 0) {
+			printf("SWEET MXT: T6 status=%#x%s%s%s%s%s\n", st6,
+			    (st6 & 0x80) ? " RESET" : "",
+			    (st6 & 0x20) ? " SIGERR" : "",
+			    (st6 & 0x10) ? " CAL" : "",
+			    (st6 & 0x08) ? " CFGERR" : "",
+			    (st6 & 0x04) ? " COMSERR" : "");
+		}
+	}
+
+	/* --- T7 power config (3 bytes) -------------------------------- */
+	if (mxt_t7_addr) {
+		uint8_t t7[3] = {0};
+		if (mxt_read_chunked(mxt_t7_addr, t7, 3) == 0) {
+			printf("SWEET MXT: T7 power=%02x %02x %02x\n",
+			    t7[0], t7[1], t7[2]);
+		}
+	}
+
+	/* --- ATTN pad level + drain pending T5 messages ---------------- */
+	unsigned attn_before = (touch_rd(st.gpio + XZ3_TLMM_WEST_OFS,
+	    TOUCH_GPIO_IO(XZ3_GPIO_ATTN)) & 1u) ? 1u : 0u;
+	unsigned msg_size = (mxt_t5_size > 1u) ? (mxt_t5_size - 1u) : 0u;
+	unsigned drained = 0;
+	unsigned logged = 0;
+	if (msg_size > 0 && msg_size <= 16u) {
+		for (unsigned k = 0; k < 32u; ++k) {
+			uint8_t m[16] = {0};
+			if (mxt_read_chunked(mxt_t5_addr, m, msg_size) != 0) {
+				break;
+			}
+			if (m[0] == 0xFFu) {
+				break;
+			}
+			++drained;
+			if (logged < 5) {
+				unsigned nshow = msg_size < 8u ? msg_size : 8u;
+				printf("SWEET MXT: msg id=%u", m[0]);
+				for (unsigned b = 1; b < nshow; ++b) {
+					printf(" %02x", m[b]);
+				}
+				printf("\n");
+				++logged;
+			}
+		}
+	}
+	unsigned attn_after = (touch_rd(st.gpio + XZ3_TLMM_WEST_OFS,
+	    TOUCH_GPIO_IO(XZ3_GPIO_ATTN)) & 1u) ? 1u : 0u;
+	printf("SWEET MXT: drained=%u attn_before=%u attn_after=%u\n",
+	    drained, attn_before, attn_after);
+
+	printf("SWEET MXT: B1 parse complete, B2 will poll + emit HID\n");
+	return true;
+}
+
+static void
+touch_xz3_thread(__unused void *arg, __unused wait_result_t result)
+{
+	unsigned delay_s = 20;
+
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TS: akatsuki mXT640U, starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+
+	st.gcc = ml_io_map(XZ3_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(XZ3_TLMM_BASE, XZ3_TLMM_SIZE);
+	st.gpio_s = st.gpio;              /* single tile */
+	st.se = ml_io_map(XZ3_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("SWEET TS: MMIO mapping failed\n");
+		goto out;
+	}
+
+	/* VDD (AVDD) on PM8998 LDO28: skip RPMh for now, assume ABL left it on. */
+	printf("SWEET TS: RPMh skipped, assuming AVDD is on\n");
+
+	/* Sequence per Linux atmel_mxt_ts: hold reset low before power,
+	 * VDDIO on, ATTN input pull-up, settle 150 ms, release reset,
+	 * 200 ms chip boot, then mux SDA/SCL to QUP.
+	 * drive=0 (2 mA) + pull=3 (pull-up) matches ABL's cfg=0x203. */
+	touch_gpio_at(st.gpio + XZ3_TLMM_NORTH_OFS, XZ3_GPIO_RESET, 0, 3, 0, true, false);
+	touch_gpio_at(st.gpio + XZ3_TLMM_NORTH_OFS, XZ3_GPIO_VIO, 0, 3, 0, true, true);
+	touch_gpio_at(st.gpio + XZ3_TLMM_WEST_OFS, XZ3_GPIO_ATTN, 0, 3, 0, false, false);
+	touch_wait(150);   /* supply settle */
+	touch_gpio_at(st.gpio + XZ3_TLMM_NORTH_OFS, XZ3_GPIO_RESET, 0, 3, 0, true, true);
+	touch_wait(200);   /* chip boot */
+	touch_gpio_at(st.gpio + XZ3_TLMM_WEST_OFS, 85, 1, 0, 0, false, false);
+	touch_gpio_at(st.gpio + XZ3_TLMM_WEST_OFS, 86, 1, 0, 0, false, false);
+	printf("SWEET TS: GPIO post g99 cfg=%#x io=%#x g133 cfg=%#x io=%#x\n",
+	    touch_rd(st.gpio + XZ3_TLMM_NORTH_OFS, TOUCH_GPIO_CFG(99)),
+	    touch_rd(st.gpio + XZ3_TLMM_NORTH_OFS, TOUCH_GPIO_IO(99)),
+	    touch_rd(st.gpio + XZ3_TLMM_NORTH_OFS, TOUCH_GPIO_CFG(133)),
+	    touch_rd(st.gpio + XZ3_TLMM_NORTH_OFS, TOUCH_GPIO_IO(133)));
+	printf("SWEET TS: SE5 muxed g85 cfg=%#x io=%#x g86 cfg=%#x io=%#x\n",
+	    touch_rd(st.gpio + XZ3_TLMM_WEST_OFS, TOUCH_GPIO_CFG(85)),
+	    touch_rd(st.gpio + XZ3_TLMM_WEST_OFS, TOUCH_GPIO_IO(85)),
+	    touch_rd(st.gpio + XZ3_TLMM_WEST_OFS, TOUCH_GPIO_CFG(86)),
+	    touch_rd(st.gpio + XZ3_TLMM_WEST_OFS, TOUCH_GPIO_IO(86)));
+
+	if (!xz3_clocks()) {
+		goto out;
+	}
+	/* TLMM tile probe: read-only, no writes. SDM845 TLMM is tiled
+	 * inside the 12 MiB window (WEST=0x100000, NORTH=0x500000,
+	 * SOUTH=0x900000). cfg=0 means wrong tile (unmapped) or
+	 * bias-disabled input. io bit0=pad level, bit1=latch. */
+	{
+		static const uint32_t toff[4] = { 0, 0x100000, 0x500000, 0x900000 };
+		static const char *tname[4] = { "flat", "W", "N", "S" };
+		static const int pp[5] = { 85, 86, 99, 125, 133 };
+		for (unsigned p = 0; p < 5; ++p) {
+			for (unsigned t = 0; t < 4; ++t) {
+				uint32_t o = toff[t] + 0x1000u * pp[p];
+				printf("SWEET TLMM g%d %s cfg=%#x io=%#x\n",
+				    pp[p], tname[t],
+				    touch_rd(st.gpio, o), touch_rd(st.gpio, o + 4));
+			}
+		}
+	}
+
+	printf("SWEET TS: calling touch_se_init\n");
+	if (!touch_se_init()) {
+		printf("SWEET TS: touch_se_init failed\n");
+		goto out;
+	}
+	printf("SWEET TS: touch_se_init OK\n");
+
+	/* --- first milestone: info block only ------------------------------- */
