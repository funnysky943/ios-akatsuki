--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -312,2 +312,31 @@
 {
+	static bool dpuDone = false;
+	if (!dpuDone) {
+	    int enable = 0;
+	    PE_parse_boot_argn("vig0reprogram", &enable, sizeof(enable));
+	    if (enable) {
+	        extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t) __asm__("_ml_io_map");
+	        volatile uint32_t *top = (volatile uint32_t *)ml_io_map(0xae01000, 0x1000);
+	        volatile uint32_t *ctl0 = (volatile uint32_t *)ml_io_map(0xae02000, 0x400);
+	        volatile uint32_t *lm0 = (volatile uint32_t *)ml_io_map(0xae45000, 0x1000);
+	        volatile uint32_t *pp0 = (volatile uint32_t *)ml_io_map(0xae71000, 0x800);
+	        volatile uint32_t *dsc0 = (volatile uint32_t *)ml_io_map(0xae81000, 0x400);
+	        volatile uint32_t *dsc1 = (volatile uint32_t *)ml_io_map(0xae81400, 0x400);
+	        if (top && ctl0 && lm0 && pp0 && dsc0 && dsc1) {
+	            IOLog("SWEET FB: TOP_HWVER=%#x\n", top[0x00/4]);
+	            IOLog("SWEET FB: CTL0 L0=%#x L1=%#x L2=%#x L3=%#x L4=%#x TOP=%#x FLUSH=%#x\n",
+	                ctl0[0x00/4], ctl0[0x04/4], ctl0[0x08/4], ctl0[0x0c/4], ctl0[0x10/4],
+	                ctl0[0x14/4], ctl0[0x18/4]);
+	            IOLog("SWEET FB: LM0 OP_MODE=%#x OUT_SIZE=%#x\n",
+	                lm0[0x00/4], lm0[0x04/4]);
+	            IOLog("SWEET FB: PP0 CFG=%#x AUTOREFRESH=%#x\n",
+	                pp0[0x00/4], pp0[0x30/4]);
+	            IOLog("SWEET FB: DSC0 COMMON=%#x PICTURE=%#x DSC1 COMMON=%#x PICTURE=%#x\n",
+	                dsc0[0x00/4], dsc0[0x04/4], dsc1[0x00/4], dsc1[0x04/4]);
+	        } else {
+	            IOLog("SWEET FB: DPU map failed\n");
+	        }
+	    }
+	    dpuDone = true;
+	}
 	AppleCLCD *fb = (AppleCLCD *)owner;
