+class AppleM2ScalerCSCDriver : public IOService {
+    OSDeclareDefaultStructors(AppleM2ScalerCSCDriver)
+public:
+    virtual bool start(IOService *provider) override {
+        if (!IOService::start(provider)) return false;
+        registerService();
+        return true;
+    }
+    virtual IOReturn newUserClient(task_t owningTask, void *securityID,
+        UInt32 type, OSDictionary *properties,
+        LIBKERN_RETURNS_RETAINED IOUserClient **handler) override {
+        SweetScalerStubClient *c = OSTypeAlloc(SweetScalerStubClient);
+        if (c == nullptr) return kIOReturnNoMemory;
+        if (!c->initWithTask(owningTask, securityID, type) ||
+            !c->attach(this) || !c->start(this)) {
+            c->release();
+            return kIOReturnError;
+        }
+        *handler = c;
+        return kIOReturnSuccess;
+    }
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver, IOService)
