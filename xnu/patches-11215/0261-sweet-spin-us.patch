+extern void machine_delay_until(uint64_t interval, uint64_t deadline);
+
 /*
+ * delay() is not a spin here: for anything above the per-thread spin
+ * threshold it does assert_wait_deadline + thread_block, and timed wakeups
+ * lose whole seconds on this port ("1 s" waits took 10 s or never returned).
+ * Spin the way delay() itself spins, by calling the loop it dispatches to.
+ */
+void
+sweet_spin_us(uint64_t usec)
+{
+	uint64_t interval;
+
+	nanoseconds_to_absolutetime(usec * 1000, &interval);
+	machine_delay_until(interval, mach_absolute_time() + interval);
+}
+
+/*
  * Flush the console ring to the partition now and wait (bounded, 500 ms)
